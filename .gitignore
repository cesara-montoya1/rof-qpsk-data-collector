# ==========================================================
# OptNET ML - Git Ignore Rules
# ==========================================================

# Virtual Environments & Package Managers
.pixi/
.venv/
venv/
env/
ENV/

# Python compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Results, heavy datasets & raw signals (DO NOT TRACK)
results/
old_db/
data/
*.complex64
*.npz
*.csv
*.mat
*.dat
*.log

# Allow reference transmission pattern if needed
!qpsk_src/data/tx.txt

# Generated plots & graphics (DO NOT TRACK)
plots/
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# Editor & OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursorignore
.cursorindexingignore
